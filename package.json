{
  "name": "clawdeck",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun dev.ts",
    "start": "bun src/index.ts",
    "build": "bun run --cwd web build",
    "typecheck": "bunx tsc --noEmit && bun run --cwd web typecheck",
    "lint": "bun run --cwd web lint",
    "test": "bun test",
    "demo": "bun run --cwd web demo",
    "shots": "bun scripts/screenshot.ts",
    "check": "bun run typecheck && bun run lint && bun run test && bun run build"
  },
  "dependencies": {
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "playwright": "^1.62.0"
  }
}
